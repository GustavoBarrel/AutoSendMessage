# Copie para .env e preencha (o .env é ignorado pelo git; nunca commite segredos).
#   cp .env.example .env

# --- Django ---
# DEBUG=True só para desenvolvimento local (página de erro detalhada, SECRET_KEY opcional,
# HTTPS desligado). Com DEBUG=False (padrão), a SECRET_KEY é obrigatória e o app liga cookies
# seguros e redirecionamento para HTTPS (veja USE_HTTPS abaixo). Com Docker Compose, DEBUG é
# fixado em False pelo docker-compose.yml.
DEBUG=False
# Obrigatória com DEBUG=False; o app não sobe com este placeholder. Gere uma chave longa e
# aleatória, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-segura-longa-e-aleatoria
# Hosts aceitos (separados por vírgula) e origens HTTPS confiáveis para formulários/CSRF.
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1],app.exemplo.com
# CSRF_TRUSTED_ORIGINS=https://app.exemplo.com
# HTTPS: padrão = ligado quando DEBUG=False. Para servir em HTTP puro (rede local ou a demo no
# Docker), use USE_HTTPS=False. Atrás de um proxy que termina o TLS, deixe USE_HTTPS ligado e
# defina TRUST_X_FORWARDED_PROTO=True (o proxy precisa sempre enviar X-Forwarded-Proto).
# USE_HTTPS=False
# TRUST_X_FORWARDED_PROTO=False
# Chave Fernet dedicada para cifrar o token da Meta no banco (opcional; sem ela, deriva da
# SECRET_KEY). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEY=

# --- Banco de dados ---
# Fora do Docker: "sqlite" (padrão, arquivo db.sqlite3) ou "postgres".
# No Compose o engine e o host são fixados (Postgres no serviço "db"); só nome, usuário e
# senha vêm daqui.
DB_ENGINE=sqlite
DB_NAME=autosendmessage
DB_USER=autosendmessage
# Obrigatória no Docker Compose (senha do Postgres do app).
DB_PASSWORD=troque-esta-senha
DB_HOST=localhost
DB_PORT=5432

# --- Provedor simulado de WhatsApp ---
# Quando True, o formulário de chip oferece o provedor "Simulado" (não envia nada de verdade).
# O docker-compose.yml já liga esta opção para a demonstração.
SIMULATED_PROVIDER_ENABLED=False

# --- Dados de demonstração ---
# Só no Docker Compose: com SEED_DEMO=1 o serviço web roda `python manage.py seed_demo --force`
# depois do migrate (dados fictícios, celulares com DDD 00 que não existe, chips simulados;
# idempotente; não cria usuário nem senha). Qualquer outro valor não cria nada.
# Fora do Docker, rode `python manage.py seed_demo` (exige DEBUG=True ou --force).
SEED_DEMO=0

# --- Evolution API (opcional; só para enviar mensagens reais) ---
# URL da sua Evolution. Com `docker compose --profile evolution up -d` e o app também no
# Compose, use http://evolution-api:8080; rodando o app fora do Docker, use
# http://localhost:18080 (porta EVOLUTION_HOST_PORT).
EVOLUTION_URL_BASE=http://localhost:18080
# Chave de autenticação da Evolution (AUTHENTICATION_API_KEY); obrigatória com o profile
# "evolution". Use a mesma no app e no serviço.
EVOLUTION_API_KEY=coloque-uma-chave-aleatoria-para-a-evolution
# Só para o profile "evolution": senha do Postgres da Evolution.
EVOLUTION_DB_PASSWORD=troque-esta-senha-da-evolution
# Porta do host da Evolution (padrão 18080, escolhida para não colidir com a 8080).
EVOLUTION_HOST_PORT=18080
